# 复制为 .env 后按需修改。.env 只放非机密配置；口令和密钥在 secrets/ 下（./gen-secrets.sh 生成）。

# ---------------------------------------------------------------- 开发/演示（docker compose up）
PROFILE=dev
WEB_PORT=80
# 以下仅开发编排使用的默认值；生产编排（./clinic.sh）忽略它们，改从 secrets/ 读取
DB_ROOT_PASSWORD=root
DB_APP_PASSWORD=clinic_app_dev
DB_MIGRATOR_PASSWORD=clinic_migrator_dev

# 机构名称，显示在登录页与页面标题（开发、生产编排都读取）；“实践大学校医院”是演示名称
CLINIC_ORG_NAME=实践大学校医院

# ---------------------------------------------------------------- 生产（./clinic.sh up）
HTTP_PORT=80
HTTPS_PORT=443
# 当前版本未与真实的支付、校园卡、医保、电子票据平台联调，没有相关配置项

# ---------------------------------------------------------------- 国内网络加速（可选）
# MAVEN_MIRROR=https://maven.aliyun.com/repository/public
# NPM_REGISTRY=https://registry.npmmirror.com
